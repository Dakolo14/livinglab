rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Registrations collection
    match /registrations/{document} {
      // Anyone can create a registration
      allow create: if true;
      
      // Allow public read so users can verify their own registrations by email
      allow read: if true;
      
      // Allow public update ONLY for cancellations
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt'])
                    && request.resource.data.status == 'cancelled';
                    
      // Only authenticated admins can delete
      allow delete: if request.auth != null;
    }
  }
}

{
  "functions": {
    "api/**/*": {
      "includeFiles": "src/emails/*.html"
    }
  },
  "crons": [
    {
      "path": "/api/cron-emails",
      "schedule": "0 8 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
